static char history[20][512];
static int hist_count = 0;

static void hist_add(const char *expr) {
    if (hist_count < 20) {
        strncpy(history[hist_count], expr, 512 - 1);
        hist_count++;
    } else {

        int i;
        for (i = 0; i < 20 - 1; i++)
            strcpy(history[i], history[i + 1]);
        strncpy(history[20 - 1], expr, 512 - 1);
    }
}

static void hist_print(void) {
    int i;
    if (hist_count == 0) { printf("  (historique vide)\n"); return; }
    for (i = 0; i < hist_count; i++)
        printf("  [%d] %s\n", i + 1, history[i]);
}





